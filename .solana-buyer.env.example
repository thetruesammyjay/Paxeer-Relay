# Copy this file to .solana-buyer.env on the machine running the Devnet buyer.
# Never reuse a mainnet keypair or commit the private file.
PAXRELAY_GATEWAY_URL=http://127.0.0.1:8001
PAXRELAY_AGENT_ID=
PAXRELAY_AGENT_API_KEY=

# Base58 secret key, or one-line JSON array from Solana CLI, for a disposable
# funded Solana Devnet keypair.
SOLANA_DEVNET_PRIVATE_KEY=
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_X402_MAX_AMOUNT_ATOMIC=10000
