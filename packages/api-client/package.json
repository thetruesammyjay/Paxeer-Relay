{
  "name": "@paxrelay/api-client",
  "version": "0.1.0",
  "description": "Generated TypeScript client for the PaxRelay API (built from OpenAPI spec)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/openapi.json -o src/generated/schema.ts",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  },
  "license": "Apache-2.0"
}
