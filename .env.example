# Application
APP_ENV=development
APP_NAME=PaxRelay
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
API_CORS_ORIGINS=["http://localhost:3000"]
READINESS_TIMEOUT_SECONDS=3
API_MAX_REQUEST_BYTES=1048576
GATEWAY_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000

# Database (Railway PostgreSQL in production, Docker locally)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/paxrelay
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Railway Redis in production, Docker locally)
RAILWAY_REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=paxrelay
API_RATE_LIMIT_MAX_REQUESTS=300
API_RATE_LIMIT_WINDOW_SECONDS=60

# Authentication
AUTH_SECRET=replace-me-with-a-secure-random-string
JWT_ISSUER=paxrelay
JWT_AUDIENCE=paxrelay-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Dashboard single sign-on (configure in staging and production)
# Register https://<web-host>/api/auth/callback/workspace-sso with the OIDC provider.
# Keep WEB_AUTH_SECRET, API AUTH_SECRET, and INTERNAL_DASHBOARD_AUTH_SECRET distinct.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
WEB_AUTH_SECRET=
INTERNAL_DASHBOARD_AUTH_SECRET=
DASHBOARD_OIDC_ISSUER=

# Encryption
APPLICATION_ENCRYPTION_KEY=replace-me-with-a-secure-random-string
RECEIPT_SIGNING_BACKEND=local
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_SIGNING_KEY_ID=local-development
# Optional public-only manifest served at GET /v1/receipt-keys.
# RECEIPT_PUBLIC_KEYRING_FILE=/run/config/receipt-keyring.json

# Paxeer Network
PAXEER_CHAIN_ID=125
PAXEER_RPC_URL=https://public-rpc.paxeer.app/rpc
PAXEER_EXPLORER_URL=https://paxscan.io
PAXEER_CONFIRMATION_POLICY=layerx_verified
# This label is checked at startup; verify RPC and LayerX endpoint identity separately.
PAXEER_NETWORK_ENVIRONMENT=mainnet
# Development can use mocks. Staging and production must explicitly set false.
USE_MOCK_ADAPTER=true
PAXEER_ADAPTER_TIMEOUT_SECONDS=15

# Settlement reconciliation worker
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=8081
EXECUTION_RECOVERY_INTERVAL_SECONDS=60
EXECUTION_RECOVERY_STALE_SECONDS=300
EXECUTION_RECOVERY_BATCH_SIZE=100
RECONCILIATION_BATCH_SIZE=50
RECONCILIATION_CONCURRENCY=10
RECONCILIATION_CLAIM_LEASE_SECONDS=120
RECONCILIATION_RETRY_INITIAL_SECONDS=30
RECONCILIATION_RETRY_MAX_SECONDS=3600

# Adapter and LayerX 402LXP HTTP v2 configuration. Live mode requires a
# sequencer key, network ID, USDX asset ID, public gateway URL, and each
# provider's LayerX account ID. Staging also pins a funded test payer.
LAYERX_API_URL=
PAXEER_SETTLEMENT_API_URL=
PAXEER_L1_SETTLEMENT_CONTRACT_ADDRESS=
PAXEER_L1_COMMITMENT_EVENT_TOPIC=
PAXEER_L1_CONFIRMATION_BLOCKS=
LAYERX_RPC_URL=
LAYERX_USDX_ADDRESS=
LAYERX_PAYMENT_VERIFIER_ADDRESS=
LAYERX_REGISTRY_ADDRESS=
LAYERX_SETTLEMENT_RECORD_ADDRESS=
# LAYERX_NETWORK_ID=<LayerX testnet/mainnet numeric network ID>
LAYERX_USDX_ASSET_ID=
LAYERX_SEQUENCER_PUBLIC_KEY=
LAYERX_TESTNET_PAYER_ACCOUNT=
GATEWAY_PUBLIC_BASE_URL=

# 402LXP
LXP402_ENABLED=true
LXP402_QUOTE_TTL_SECONDS=300
POLICY_APPROVAL_TTL_SECONDS=900
LXP402_MAX_CLOCK_SKEW_SECONDS=30
LXP402_REQUIRE_REQUEST_HASH=true

# Provider Routing
ROUTER_DEFAULT_STRATEGY=balanced
ROUTER_REGISTRY_CACHE_TTL_SECONDS=30
ROUTER_MAX_PROVIDER_ATTEMPTS=2
ROUTER_HEALTH_FAILURE_THRESHOLD=3
ROUTER_CIRCUIT_OPEN_SECONDS=60
PROVIDER_HEALTH_CONCURRENCY=10
PROVIDER_METRICS_WINDOW_DAYS=7
PROVIDER_METRICS_TRAILING_ATTEMPTS=100

# Background spend rollups; hourly and daily history windows
ANALYTICS_FLUSH_INTERVAL_SECONDS=60
ANALYTICS_HOURLY_RETENTION_DAYS=30
ANALYTICS_DAILY_RETENTION_DAYS=400
ANALYTICS_ROLLUP_MAX_AGE_SECONDS=180

# Gateway
GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_MAX_REQUEST_BYTES=1048576
GATEWAY_MAX_RESPONSE_BYTES=10485760
GATEWAY_RATE_LIMIT_MAX_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_MAX_CONCURRENT_REQUESTS_PER_KEY=10
GATEWAY_CONCURRENCY_LEASE_SECONDS=600
# Request-rate and concurrency enforcement are enabled by default in staging/production.
# These controls cannot be disabled in production.
# GATEWAY_RATE_LIMIT_ENABLED=true
# Used by the gateway and worker health probes. Required in staging/production.
# Use comma-separated exact hostnames; no wildcards.
PROVIDER_ENDPOINT_HOST_ALLOWLIST=

# Object Storage (Cloudflare R2 or S3-compatible)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=paxrelay-receipts
S3_REGION=auto

# Webhooks
WEBHOOK_ENCRYPTION_KEY=replace-me-with-a-different-secure-random-string
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_INITIAL_RETRY_SECONDS=30
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_MAX_REQUEST_BYTES=1048576
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_DELIVERY_BATCH_SIZE=50
WEBHOOK_DELIVERY_CONCURRENCY=10
WEBHOOK_DELIVERY_LEASE_SECONDS=120

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true

# Next.js (public env vars — prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
PAXRELAY_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_GATEWAY_BASE_URL=http://localhost:8080
