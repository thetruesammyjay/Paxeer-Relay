# Copy to .layerx-buyer.env. This file is ignored by Git and is for the
# operator-run buyer only. Keep the RPC key secret out of gateway deployment
# variables. The duplicated trust values must match the staging gateway.
GATEWAY_PUBLIC_BASE_URL=https://<public gateway host>
LAYERX_NETWORK_ID=<test network id>
LAYERX_USDX_ASSET_ID=<registered USDX asset id as 64 hex characters>
LAYERX_SEQUENCER_PUBLIC_KEY=<test sequencer public key as 64 hex characters>
LAYERX_TESTNET_PAYER_ACCOUNT=<funded test payer account as 64 hex characters>

LAYERX_TESTNET_RPC_URL=https://<test RPC host>/rpc
LAYERX_TESTNET_API_KEY_ID=<operator key id>
LAYERX_TESTNET_API_KEY_SECRET=<operator secret>
LAYERX_TESTNET_NETWORK_ID=<same test network id>
LAYERX_TESTNET_SEQUENCER_PUBLIC_KEY=<same pinned sequencer key>
